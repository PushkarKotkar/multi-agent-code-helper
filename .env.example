# NVIDIA NIM — obtain an API key from https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-replace-me
NVIDIA_NIM_API_KEY=nvapi-replace-me
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# Pinecone — obtain an API key from https://app.pinecone.io/
PINECONE_API_KEY=replace-me
PINECONE_INDEX_NAME=code-helper
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Project to analyse. Use an absolute path; default is the current directory.
CODEBASE_PATH=../Naive_RAG
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K=4
